#!/usr/bin/env bash
# test-release — regression test for scripts/release.
#
# Builds a throwaway tool repo and tap under $TMPDIR, each pushing to a local bare
# remote, with this tap's scripts/release copied into the fake tap and the tool's
# scripts/release.conf naming a stub check command. Stub `curl` and `brew` go first on
# PATH, so no real build, download or Homebrew call happens. Then checks every state a
# release can be found in: nothing done, bumped and pushed but untagged, tagged but the
# formula stale, fully released — plus the refusals (bad version, dirty tree, conflicting
# tag, failing check, a missing or broken release.conf) and a dry run that touches
# nothing. Exits non-zero on the first failed assertion.
#
# Runs sandboxed: it needs git, and nothing from the network.
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
release_src="${script_dir}/release"

work="$(mktemp -d "${TMPDIR:-/tmp}/release-test.XXXXXX")"
trap 'rm -rf "$work"' EXIT

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 XDG_CONFIG_HOME="${work}/xdg"
export GIT_AUTHOR_NAME=Test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=Test GIT_COMMITTER_EMAIL=test@example.com

fail() {
    echo "FAIL [${case_name:-setup}]: $1" >&2
    [[ -f "${work}/out" ]] && sed 's/^/    | /' "${work}/out" >&2
    exit 1
}

# --- Stubs ------------------------------------------------------------------------------

stubs="${work}/stubs"
mkdir -p "$stubs"
cat >"${stubs}/stub-check" <<'EOF'
#!/usr/bin/env bash
echo "check $*" >>"$STUB_LOG"
exit "${STUB_CHECK_EXIT:-0}"
EOF
# curl writes "tarball of <url>" to its -o file, so the sha is a function of the URL.
cat >"${stubs}/curl" <<'EOF'
#!/usr/bin/env bash
echo "curl $*" >>"$STUB_LOG"
out="" url=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        -*) shift ;;
        *) url="$1"; shift ;;
    esac
done
printf 'tarball of %s' "$url" >"$out"
EOF
# brew bottle writes a tarball of fixed bytes and the JSON beside it, named for the
# machine's own tag, not the formula's oldest macOS, which the script retags it to.
cat >"${stubs}/brew" <<'EOF'
#!/usr/bin/env bash
echo "brew $*" >>"$STUB_LOG"
case "$1" in
    --repository) echo "$STUB_BREW_TAP" ;;
    --cellar) echo "$STUB_CELLAR" ;;
    list) [[ -n "${STUB_BREW_INSTALLED:-}" ]] ;;
    bottle)
        printf 'bottle bytes' >"demo--9.9.9.arm64_hosttag.bottle.tar.gz"
        # As brew bottle writes it: the cellar once, beside the tags, not in each.
        printf '{"bensyverson/tap/demo":{"bottle":{"cellar":"%s","tags":{"arm64_hosttag":{}}}}}' \
            "${STUB_BOTTLE_CELLAR-any_skip_relocation}" >"demo--9.9.9.arm64_hosttag.bottle.json"
        ;;
    info) printf '{"formulae":[{"installed":[{"poured_from_bottle":%s}]}]}' "${STUB_POURED:-true}" ;;
esac
EOF
# gh release view succeeds only when STUB_GH_RELEASE says the release exists.
cat >"${stubs}/gh" <<'EOF'
#!/usr/bin/env bash
echo "gh $*" >>"$STUB_LOG"
[[ "$1 $2" != "release view" || -n "${STUB_GH_RELEASE:-}" ]]
EOF
cat >"${stubs}/codesign" <<'EOF'
#!/usr/bin/env bash
echo "codesign $*" >>"$STUB_LOG"
[[ "$1" != -dvv ]] || echo "Authority=${STUB_AUTHORITY:-Developer ID Application: Test (TEAM)}" >&2
EOF
cat >"${stubs}/xcrun" <<'EOF'
#!/usr/bin/env bash
echo "xcrun $*" >>"$STUB_LOG"
printf '{"id":"sub-1","status":"%s"}\n' "${STUB_NOTARY_STATUS:-Accepted}"
EOF
chmod +x "${stubs}"/*
export PATH="${stubs}:${PATH}"

sha_of() { printf 'tarball of %s' "$1" | shasum -a 256 | cut -d' ' -f1; }
tarball() { echo "https://github.com/bensyverson/demo/archive/refs/tags/v$1.tar.gz"; }

# --- Fixture ----------------------------------------------------------------------------

# The tool's version line. A case may set these before setup to try another language.
version_file="Sources/version.go"
version_line='const version = "%s"'

# setup <version in source>: a fresh tool repo, tap and remotes, both released at
# 0.1.0; when the source says more, that commit is pushed untagged.
setup() {
    rm -rf "${work}/case"
    local root="${work}/case"
    mkdir -p "$root"
    git init -q --bare -b main "${root}/demo.git"
    git init -q --bare -b main "${root}/tap.git"

    tap="${root}/homebrew-tap"
    git init -q -b main "$tap"
    mkdir -p "${tap}/Formula" "${tap}/scripts"
    cp "$release_src" "${tap}/scripts/release"
    write_formula 0.1.0
    git -C "$tap" add -A
    git -C "$tap" commit -q -m "Adds the demo formula"
    git -C "$tap" remote add origin "${root}/tap.git"
    git -C "$tap" push -q origin main

    wc="${root}/demo"
    git init -q -b main "$wc"
    mkdir -p "${wc}/scripts" "${wc}/$(dirname "$version_file")"
    cat >"${wc}/scripts/release.conf" <<EOF
# How the tap's scripts/release publishes demo.
formula=demo
name=Demo
version_file=${version_file}
version_line=${version_line}
check=stub-check --all
${conf_extra:-}
EOF
    write_version 0.1.0
    git -C "$wc" add -A
    git -C "$wc" commit -q -m "Initial"
    git -C "$wc" tag -a v0.1.0 -m "Demo 0.1.0"
    git -C "$wc" remote add origin "${root}/demo.git"
    git -C "$wc" push -q origin main v0.1.0
    if [[ "$1" != 0.1.0 ]]; then
        write_version "$1"
        git -C "$wc" commit -q -am "Bumps version"
        git -C "$wc" push -q origin main
    fi

    export STUB_BREW_TAP="${root}/brew-tap"
    git clone -q "${root}/tap.git" "$STUB_BREW_TAP"
    export STUB_LOG="${root}/stub.log"
    : >"$STUB_LOG"
    # Each version's keg holds one real Mach-O, so the script finds something to sign.
    export STUB_CELLAR="${root}/cellar"
    for v in 0.1.0 0.1.1 0.2.0; do
        mkdir -p "${STUB_CELLAR}/${v}/bin"
        cp /usr/bin/true "${STUB_CELLAR}/${v}/bin/demo"
        echo "not code" >"${STUB_CELLAR}/${v}/README"
    done
    unset STUB_CHECK_EXIT STUB_BREW_INSTALLED STUB_BOTTLE_CELLAR STUB_POURED STUB_GH_RELEASE
    unset STUB_AUTHORITY STUB_NOTARY_STATUS
}

write_version() {
    {
        echo "// The tool's version; scripts/release bumps it."
        printf "    ${version_line}\n" "$1"
        echo "// Not the version: \"9.9.9\""
    } >"${wc}/${version_file}"
}

write_formula() {
    cat >"${tap}/Formula/demo.rb" <<EOF
class Demo < Formula
  desc "Test formula"
  url "$(tarball "$1")"
  sha256 "$(sha_of "$(tarball "$1")")"
  license "MIT"
${formula_bottle:-}
  depends_on macos: :sequoia
end
EOF
}

# release <expected exit> <args…>: runs the tap's script from a subdirectory of the tool.
release() {
    local expected="$1" status=0
    shift
    (cd "${wc}/Sources" && "${tap}/scripts/release" "$@") >"${work}/out" 2>&1 </dev/null || status=$?
    [[ "$status" == "$expected" ]] || fail "exit ${status}, expected ${expected}"
}

assert_out() { grep -qF -- "$1" "${work}/out" || fail "output lacks: $1"; }
assert_log() { grep -qF -- "$1" "$STUB_LOG" || fail "no stub call: $1 (log: $(tr '\n' ';' <"$STUB_LOG"))"; }
refute_log() { ! grep -qF -- "$1" "$STUB_LOG" || fail "unexpected stub call: $1"; }
# The version on the line release.conf names, not the decoy below it.
source_version() {
    local prefix="${version_line%%"%s"*}"
    grep -F "$prefix" "${wc}/${version_file}" | head -1 | sed 's/.*"\([0-9.]*\)".*/\1/'
}
remote_tag() { git -C "${work}/case/demo.git" rev-parse -q --verify "refs/tags/v$1^{commit}" || true; }
remote_formula() { git -C "${work}/case/tap.git" show main:Formula/demo.rb; }

assert_released() {
    local v="$1"
    [[ -n "$(remote_tag "$v")" ]] || fail "v${v} not pushed"
    [[ "$(git -C "${work}/case/demo.git" cat-file -t "v${v}")" == tag ]] || fail "v${v} is not annotated"
    git -C "${work}/case/demo.git" cat-file -p "v${v}" | grep -qF "Demo ${v}" || fail "tag message is not 'Demo ${v}'"
    [[ "$(git -C "${work}/case/demo.git" show "v${v}:${version_file}")" == *"\"${v}\""* ]] ||
        fail "v${v} does not carry version ${v}"
    remote_formula | grep -qF "url \"$(tarball "$v")\"" || fail "formula url not at ${v}"
    remote_formula | grep -qF "sha256 \"$(sha_of "$(tarball "$v")")\"" || fail "formula sha256 wrong"
    git -C "${work}/case/tap.git" log --format=%s main | grep -qF "Bumps demo to ${v}" || fail "tap commit subject"
    [[ -z "$(git -C "$wc" status --porcelain)" ]] || fail "repo left dirty"
    [[ -z "$(git -C "$tap" status --porcelain)" ]] || fail "tap left dirty"
    assert_log "brew install bensyverson/tap/demo"
    # The formula has no bottles, so Homebrew builds from source anyway; the flag only
    # adds a "building from source is not supported" warning.
    refute_log "--build-from-source"
    assert_log "brew test bensyverson/tap/demo"
    assert_log "brew audit --strict bensyverson/tap/demo"
    git -C "$STUB_BREW_TAP" log -1 --format=%s | grep -qF "$v" || fail "brew's tap clone not updated"
}

# --- Cases ------------------------------------------------------------------------------

case_name="usage: malformed version"
setup 0.1.0
release 2 1.2
assert_out "X.Y.Z"
release 2 --bogus
release 2 0.1.1 0.1.2

case_name="usage: version older than the source"
setup 0.1.1
release 2 0.1.0
assert_out "0.1.1"

case_name="usage: run from the tap itself"
setup 0.1.0
status=0
(cd "$tap" && scripts/release) >"${work}/out" 2>&1 </dev/null || status=$?
[[ "$status" == 2 ]] || fail "exit ${status}, expected 2"
assert_out "tool's checkout"

case_name="no release.conf"
setup 0.1.0
git -C "$wc" rm -q scripts/release.conf
git -C "$wc" commit -q -m "Drops the conf"
release 3
assert_out "release.conf"

case_name="release.conf without a %s in version_line"
setup 0.1.0
sed -i.bak 's/^version_line=.*/version_line=const version/' "${wc}/scripts/release.conf"
rm "${wc}/scripts/release.conf.bak"
git -C "$wc" commit -q -am "Breaks the conf"
release 3
assert_out "%s"

case_name="release.conf with an unknown key"
setup 0.1.0
echo "colour=red" >>"${wc}/scripts/release.conf"
git -C "$wc" commit -q -am "Adds a stray key"
release 3
assert_out "colour"

case_name="--repo names the tool from anywhere"
setup 0.1.0
status=0
(cd "$work" && "${tap}/scripts/release" --repo "$wc" --dry-run 0.1.1) >"${work}/out" 2>&1 </dev/null || status=$?
[[ "$status" == 0 ]] || fail "exit ${status}, expected 0"
assert_out "would bump"

case_name="nothing new: verifies and says how to release"
setup 0.1.0
release 0
assert_out "already released"
assert_out "scripts/release <version>"
assert_log "brew test bensyverson/tap/demo"

case_name="dirty tree"
setup 0.1.0
echo "// edit" >>"${wc}/${version_file}"
release 3 0.1.1
assert_out "uncommitted"
[[ -z "$(remote_tag 0.1.1)" ]] || fail "tagged despite a dirty tree"

case_name="dirty tree is fine once tagged: the tool repo is only read"
setup 0.1.1
git -C "$wc" tag -a v0.1.1 -m "Demo 0.1.1"
git -C "$wc" push -q origin v0.1.1
echo "// another session's edit" >>"${wc}/${version_file}"
release 0
grep -qF "another session's edit" "${wc}/${version_file}" || fail "the edit was touched"
git -C "$wc" checkout -q -- "$version_file"
assert_released 0.1.1

case_name="dirty tap"
setup 0.1.0
echo "# edit" >>"${tap}/Formula/demo.rb"
release 3 0.1.1
assert_out "uncommitted"

case_name="behind origin"
setup 0.1.0
git clone -q "${work}/case/demo.git" "${work}/case/other"
git -C "${work}/case/other" commit -q --allow-empty -m "Elsewhere"
git -C "${work}/case/other" push -q origin main
release 3 0.1.1
assert_out "behind"

case_name="dry run"
setup 0.1.0
before="$(git -C "$wc" rev-parse HEAD)"
release 0 0.1.1 --dry-run
assert_out "would"
assert_out "stub-check --all"
[[ "$(git -C "$wc" rev-parse HEAD)" == "$before" ]] || fail "dry run committed"
[[ "$(source_version)" == 0.1.0 ]] || fail "dry run edited the version"
[[ -z "$(remote_tag 0.1.1)" ]] || fail "dry run tagged"
remote_formula | grep -qF "v0.1.0.tar.gz" || fail "dry run moved the formula"
refute_log "check"
refute_log "brew install"

case_name="full release from scratch"
setup 0.1.0
release 0 0.1.1
[[ "$(source_version)" == 0.1.1 ]] || fail "version not bumped"
grep -qF '"9.9.9"' "${wc}/${version_file}" || fail "the bump touched a line that isn't the version"
[[ "$(git -C "${work}/case/demo.git" rev-parse main)" == "$(git -C "$wc" rev-parse HEAD)" ]] ||
    fail "bump not pushed"
assert_log "check --all"
assert_released 0.1.1

case_name="full release of a Swift-style version line"
version_file="Sources/Version.swift"
version_line='static let current = "%s"'
setup 0.1.0
release 0 0.2.0
[[ "$(source_version)" == 0.2.0 ]] || fail "version not bumped"
assert_released 0.2.0
version_file="Sources/version.go"
version_line='const version = "%s"'

case_name="resume: bumped and pushed, not tagged"
setup 0.1.1
head="$(git -C "$wc" rev-parse HEAD)"
release 0
[[ "$(git -C "$wc" rev-parse HEAD)" == "$head" ]] || fail "made a commit it did not need"
[[ "$(remote_tag 0.1.1)" == "$head" ]] || fail "tag not on the bump commit"
assert_log "check --all"
assert_released 0.1.1

case_name="resume: explicit version equal to the source"
setup 0.1.1
release 0 0.1.1
assert_released 0.1.1

case_name="resume: tagged, formula stale"
setup 0.1.1
git -C "$wc" tag -a v0.1.1 -m "Demo 0.1.1"
git -C "$wc" push -q origin v0.1.1
git -C "$wc" commit -q --allow-empty -m "Later work"
git -C "$wc" push -q origin main
release 0
refute_log "check"
assert_released 0.1.1

case_name="resume: fully released reruns only the Homebrew check"
setup 0.1.0
release 0 0.1.1
: >"$STUB_LOG"
release 0
assert_out "already released"
refute_log "check"
refute_log "curl"
assert_log "brew test bensyverson/tap/demo"

case_name="conflict: tag exists on another commit"
setup 0.1.0
git -C "$wc" tag -a v0.1.1 -m "Stray" HEAD
git -C "$wc" push -q origin v0.1.1
release 3 0.1.1
assert_out "v0.1.1"
[[ "$(source_version)" == 0.1.0 ]] || fail "bumped despite the conflict"

case_name="failing check"
setup 0.1.0
export STUB_CHECK_EXIT=1
release 5 0.1.1
[[ "$(source_version)" == 0.1.0 ]] || fail "bump left behind after a failing check"
[[ -z "$(git -C "$wc" status --porcelain)" ]] || fail "repo left dirty"
[[ -z "$(remote_tag 0.1.1)" ]] || fail "tagged despite a failing check"
refute_log "curl"

case_name="already installed: reinstalls"
setup 0.1.1
export STUB_BREW_INSTALLED=1
release 0
assert_log "brew reinstall bensyverson/tap/demo"
refute_log "brew install"
refute_log "--build-from-source"

case_name="--skip-tests and --no-verify"
setup 0.1.1
release 0 --skip-tests --no-verify
refute_log "check"
refute_log "brew"
remote_formula | grep -qF "v0.1.1.tar.gz" || fail "formula not moved"

# --- Bottles ------------------------------------------------------------------------------

# The bottle is tagged for the formula's oldest macOS, on this machine's architecture.
bottle_tag="$([[ "$(uname -m)" == arm64 ]] && echo arm64_)sequoia"
bottle_sha="$(printf 'bottle bytes' | shasum -a 256 | cut -d' ' -f1)"
bottle_url() { echo "https://github.com/bensyverson/demo/releases/download/v$1"; }
sign_conf=$'bottle=yes\nsign=Developer ID Application: Test (TEAM)\nnotary_profile=demo-notary'

assert_bottled() {
    local v="$1"
    remote_formula | grep -qF "root_url \"$(bottle_url "$v")\"" || fail "formula root_url not at ${v}"
    remote_formula | grep -qF "sha256 cellar: :any_skip_relocation, ${bottle_tag}: \"${bottle_sha}\"" ||
        fail "formula lacks the ${bottle_tag} bottle"
    [[ "$(remote_formula | grep -c 'bottle do')" == 1 ]] || fail "not exactly one bottle block"
    git -C "${work}/case/tap.git" log -1 --format=%s main | grep -qF "Bottles demo ${v}" || fail "tap commit subject"
    [[ -z "$(git -C "$tap" status --porcelain)" ]] || fail "tap left dirty"
    assert_log "brew install --build-bottle bensyverson/tap/demo"
    assert_log "brew bottle --json --no-rebuild --root-url=$(bottle_url "$v") bensyverson/tap/demo"
    assert_log "gh release upload v${v} "
    assert_log "/demo-${v}.${bottle_tag}.bottle.tar.gz --repo bensyverson/demo --clobber"
    # Checked the way a user gets it: a fresh install, poured from the bottle.
    assert_log "brew uninstall --formula bensyverson/tap/demo"
    assert_log "brew info --json=v2 bensyverson/tap/demo"
    assert_log "brew test bensyverson/tap/demo"
    assert_log "brew audit --strict bensyverson/tap/demo"
}

case_name="release.conf: bottle must be yes or no"
conf_extra="bottle=maybe"
setup 0.1.0
release 3
assert_out "must be yes or no"

case_name="release.conf: sign needs bottle=yes"
conf_extra="sign=Developer ID Application: Test (TEAM)"
setup 0.1.0
release 3
assert_out "bottle=yes"

case_name="release.conf: notary_profile needs sign"
conf_extra=$'bottle=yes\nnotary_profile=demo-notary'
setup 0.1.0
release 3
assert_out "sign="

case_name="bottle=yes needs the formula's oldest macOS"
conf_extra="bottle=yes"
setup 0.1.0
sed -i.bak '/depends_on macos/d' "${tap}/Formula/demo.rb"
rm "${tap}/Formula/demo.rb.bak"
git -C "$tap" commit -q -am "Drops the macOS floor"
git -C "$tap" push -q origin main
release 3
assert_out "depends_on macos"

case_name="bottle dry run"
conf_extra="bottle=yes"
setup 0.1.0
release 0 0.1.1 --dry-run
assert_out "would build the ${bottle_tag} bottle"
refute_log "brew"
refute_log "gh"

case_name="bottle: full release builds, uploads and pours a bottle"
conf_extra="bottle=yes"
setup 0.1.0
release 0 0.1.1
assert_released 0.1.1
assert_bottled 0.1.1
assert_log "gh release create v0.1.1 --repo bensyverson/demo --verify-tag --title Demo 0.1.1 --generate-notes"
refute_log "codesign"
refute_log "xcrun"

case_name="bottle: a released but unbottled version gets bottled"
conf_extra="bottle=yes"
setup 0.1.0
release 0
assert_out "Building a bottle"
! grep -qF "already released" "${work}/out" || fail "called an unbottled version released"
assert_bottled 0.1.0

case_name="bottle: an existing GitHub release is reused"
conf_extra="bottle=yes"
setup 0.1.0
export STUB_GH_RELEASE=1
release 0
assert_bottled 0.1.0
refute_log "gh release create"

case_name="bottle: a bottled release only rechecks"
conf_extra="bottle=yes"
setup 0.1.0
release 0 0.1.1
: >"$STUB_LOG"
release 0
assert_out "already released"
refute_log "brew bottle"
refute_log "gh"
assert_log "brew info --json=v2 bensyverson/tap/demo"

case_name="bottle: the default cellar is left out of the bottle line"
conf_extra="bottle=yes"
setup 0.1.0
default_cellar="$([[ "$(uname -m)" == arm64 ]] && echo /opt/homebrew/Cellar || echo /usr/local/Cellar)"
export STUB_BOTTLE_CELLAR="$default_cellar"
release 0
remote_formula | grep -qF "    sha256 ${bottle_tag}: \"${bottle_sha}\"" || fail "default cellar not omitted"

case_name="bottle: a bottle JSON without a cellar stops before the upload"
conf_extra="bottle=yes"
setup 0.1.0
export STUB_BOTTLE_CELLAR=""
release 5
assert_out "cellar"
refute_log "gh release upload"

case_name="bottle: a bump drops the previous version's bottle"
conf_extra=""
formula_bottle=$'\n  bottle do\n    root_url "https://example.com/v0.1.0"\n    sha256 cellar: :any, arm64_sequoia: "abc"\n  end'
setup 0.1.0
formula_bottle=""
release 0 0.1.1
assert_released 0.1.1
! remote_formula | grep -qF "bottle do" || fail "stale bottle block kept"
! remote_formula | grep -qF "root_url" || fail "stale root_url kept"
remote_formula | grep -qF "depends_on macos: :sequoia" || fail "the strip took more than the bottle block"

case_name="bottle: a bottle that was not poured fails the check"
conf_extra="bottle=yes"
setup 0.1.0
export STUB_POURED=false
release 5
assert_out "instead of pouring"

case_name="sign: signs the keg's code and notarizes it before bottling"
conf_extra="$sign_conf"
setup 0.1.0
release 0
assert_bottled 0.1.0
assert_log "codesign --force --options runtime --timestamp --sign Developer ID Application: Test (TEAM) ${STUB_CELLAR}/0.1.0/bin/demo"
refute_log "${STUB_CELLAR}/0.1.0/README"
assert_log "xcrun notarytool submit"
assert_log "--keychain-profile demo-notary --wait --output-format json"
assert_log "codesign -dvv"
[[ "$(grep -n 'notarytool' "$STUB_LOG" | cut -d: -f1)" -lt "$(grep -n 'brew bottle' "$STUB_LOG" | cut -d: -f1)" ]] ||
    fail "bottled before notarizing"

case_name="sign: a rejected notarization stops before the upload"
conf_extra="$sign_conf"
setup 0.1.0
export STUB_NOTARY_STATUS=Invalid
release 5
assert_out "notarytool log sub-1"
refute_log "brew bottle"
refute_log "gh release upload"
! remote_formula | grep -qF "bottle do" || fail "formula bottled despite the rejection"

case_name="sign: a poured binary signed by someone else fails the check"
conf_extra="$sign_conf"
setup 0.1.0
export STUB_AUTHORITY="Apple Development: Someone"
release 5
assert_out "Developer ID Application: Test (TEAM)"
conf_extra=""

echo "PASS: scripts/release"
