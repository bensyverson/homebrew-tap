#!/usr/bin/env bash
# release — publish a tool's version to this Homebrew tap in one command, resuming
# wherever an earlier release stopped.
#
# Usage, from the tool's checkout (its own scripts/release runs this one):
#     <tap>/scripts/release [<X.Y.Z>] [--dry-run] [--skip-tests] [--no-verify] [--repo <dir>]
#
# The tool describes itself in scripts/release.conf, one key=value per line:
#     formula=contextfill                      Formula/<formula>.rb in this tap
#     name=contextfill                         the tag message's name (default: formula)
#     version_file=cmd/contextfill/version.go  the source file that states the version
#     version_line=const version = "%s"        the line stating it, %s for the version
#     check=make check                         lint and test, run in the repo
#     bottle=yes                               ship a prebuilt bottle (default: no)
#     sign=Developer ID Application: … (TEAM)  sign the bottle's code with this identity
#     notary_profile=notary                    and notarize it (notarytool store-credentials)
#
# With no version it releases what the source already says; with one it bumps the
# source to it first. Every step checks whether it is already done, so a release that
# was bumped and pushed but never tagged, or tagged but never put in the formula, picks
# up where it stopped:
#
#     1. bump the version, run check, commit                     (unless the source says it)
#     2. push main, then tag v<version> (annotated) and push it   (unless origin has it)
#     3. hash GitHub's tarball of the tag, rewrite the formula's
#        url and sha256, commit and push the tap                  (unless the formula has it)
#     4. with bottle=yes: build the formula with --build-bottle, sign and notarize its
#        code (with sign=), bottle it, upload the bottle to the tag's GitHub release and
#        write the formula's bottle block, commit and push the tap (unless it has one)
#     5. update Homebrew's copy of the tap, install or reinstall (a fresh install that must
#        pour the bottle, with bottle=yes), brew test and brew audit --strict
#                                                                 (always; --no-verify skips)
#
# A bottle is built on this machine but tagged for the formula's oldest macOS, its
# depends_on macos:, so one bottle serves that release and every later one; the binary
# must target that release (SwiftPM platforms:, MACOSX_DEPLOYMENT_TARGET). The bottle
# block holds this machine's architecture only; elsewhere Homebrew builds from source.
# Homebrew does not quarantine a formula's downloads, so signing is optional: it is for
# anyone who takes the binary out of the bottle by hand.
#
# Both repos must be clean, on main and not behind origin. The tool is the checkout
# holding the current directory, or --repo; the tap is the one holding this script.
# --dry-run prints the plan and changes nothing.
#
# Exits 0 on success, 2 on a usage error, 3 when a precondition fails or the state
# conflicts (a tag on another version, a dirty tree, a bad release.conf) — nothing has
# changed then — and 5 when a step fails. Needs the Bash sandbox disabled (the pushes,
# and whatever the check needs).
set -euo pipefail

tap_name="bensyverson/tap"

die() {
    echo "release: $2" >&2
    exit "$1"
}
say() { echo "==> $*"; }

target=""
dry_run=false
skip_tests=false
verify=true
repo=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) dry_run=true; shift ;;
        --skip-tests) skip_tests=true; shift ;;
        --no-verify) verify=false; shift ;;
        --repo)
            [[ $# -ge 2 ]] || die 2 "--repo needs a directory"
            repo="$2"
            shift 2
            ;;
        -h|--help) sed -n '2,50p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) die 2 "unknown flag '$1' (try --help)" ;;
        *)
            [[ -z "$target" ]] || die 2 "one version only (got '$target' and '$1')"
            target="$1"
            shift
            ;;
    esac
done

tap="$(cd "$(dirname "$0")/.." && pwd -P)"
repo="$(cd "${repo:-.}" && git rev-parse --show-toplevel 2>/dev/null)" ||
    die 2 "run it from the tool's checkout, or pass --repo"
repo="$(cd "$repo" && pwd -P)"
[[ "$repo" != "$tap" ]] || die 2 "this is the tap; run it from the tool's checkout, or pass --repo"

# --- release.conf ---------------------------------------------------------------------

conf="${repo}/scripts/release.conf"
[[ -f "$conf" ]] || die 3 "no scripts/release.conf in ${repo} (see --help for its keys)"
formula_name="" name="" version_file="" version_line="" check="" bottle=no sign="" notary_profile=""
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || die 3 "release.conf: '${line}' is not key=value"
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
        formula) formula_name="$value" ;;
        name) name="$value" ;;
        version_file) version_file="$value" ;;
        version_line) version_line="$value" ;;
        check) check="$value" ;;
        bottle) bottle="$value" ;;
        sign) sign="$value" ;;
        notary_profile) notary_profile="$value" ;;
        *) die 3 "release.conf: unknown key '${key}'" ;;
    esac
done <"$conf"
for key in formula_name version_file version_line check; do
    [[ -n "${!key}" ]] || die 3 "release.conf needs ${key/formula_name/formula}="
done
name="${name:-$formula_name}"
[[ "$bottle" == yes || "$bottle" == no ]] || die 3 "release.conf: bottle must be yes or no (got '${bottle}')"
[[ -z "$sign" || "$bottle" == yes ]] || die 3 "release.conf: sign= needs bottle=yes; only a bottle is signed"
[[ -z "$notary_profile" || -n "$sign" ]] || die 3 "release.conf: notary_profile= needs sign=; only signed code is notarized"
bottling=false
[[ "$bottle" == yes ]] && bottling=true
[[ "$version_line" == *"%s"* ]] || die 3 "release.conf: version_line needs a %s where the version goes"
version_prefix="${version_line%%"%s"*}"
version_suffix="${version_line#*"%s"}"

formula_ref="${tap_name}/${formula_name}"
formula="${tap}/Formula/${formula_name}.rb"
[[ -f "${repo}/${version_file}" ]] || die 3 "no ${version_file} in ${repo}"
[[ -f "$formula" ]] || die 3 "no formula at ${formula}"

# read_version: the version on the first line of stdin matching version_line.
read_version() {
    local line v
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == *"$version_prefix"*"$version_suffix"* ]] || continue
        v="${line#*"$version_prefix"}"
        v="${v%%"$version_suffix"*}"
        if [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "$v"
            return
        fi
    done
}

source_version="$(read_version <"${repo}/${version_file}")"
formula_url="$(sed -n 's/^ *url "\(.*\)"$/\1/p' "$formula")"
formula_version="$(sed -n 's|.*/v\([0-9][0-9.]*\)\.tar\.gz$|\1|p' <<<"$formula_url")"
[[ -n "$source_version" ]] || die 3 "no line in ${version_file} reads: ${version_line}"
[[ -n "$formula_version" ]] || die 3 "could not read the version from the formula's url"
if $bottling; then
    github_repo="$(sed -n 's|^https://github.com/\([^/]*/[^/]*\)/archive/.*|\1|p' <<<"$formula_url")"
    [[ -n "$github_repo" ]] || die 3 "bottle=yes needs the formula's url on github.com, to upload the bottle beside it"
    oldest_macos="$(sed -n 's/^ *depends_on macos: :\([a-z_]*\)$/\1/p' "$formula")"
    [[ -n "$oldest_macos" ]] ||
        die 3 "bottle=yes needs depends_on macos: :<release> in the formula, the oldest macOS the binary runs on"
    bottle_tag="${oldest_macos}"
    [[ "$(uname -m)" == arm64 ]] && bottle_tag="arm64_${oldest_macos}"
fi

target="${target:-$source_version}"
[[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die 2 "the version must be X.Y.Z (got '${target}')"
older="$(printf '%s\n%s\n' "$target" "$source_version" | sort -V | head -1)"
[[ "$target" == "$source_version" || "$older" == "$source_version" ]] ||
    die 2 "${target} is older than ${source_version}, which the source already says"

# --- Preconditions: nothing below this block changes anything until they all hold. ----

for dir in "$repo" "$tap"; do
    [[ -z "$(git -C "$dir" status --porcelain --untracked-files=no)" ]] ||
        die 3 "${dir} has uncommitted changes; commit or stash them first"
    [[ "$(git -C "$dir" symbolic-ref --short HEAD)" == main ]] || die 3 "${dir} is not on main"
    git -C "$dir" fetch -q origin main || die 3 "could not fetch origin in ${dir}"
    git -C "$dir" merge-base --is-ancestor origin/main HEAD ||
        die 3 "${dir} is behind origin/main; pull first"
done

tag="v${target}"
bump=false
[[ "$source_version" == "$target" ]] || bump=true

# The commit a ref names, peeled through an annotated tag; empty when there is none.
remote_tag_commit="$(git -C "$repo" ls-remote --tags origin "refs/tags/${tag}" "refs/tags/${tag}^{}" |
    sort -k2 | tail -1 | cut -f1)" || die 3 "could not list origin's tags"
local_tag_commit="$(git -C "$repo" rev-parse -q --verify "refs/tags/${tag}^{commit}" || true)"

if $bump && [[ -n "${remote_tag_commit}${local_tag_commit}" ]]; then
    die 3 "${tag} already exists, but the source says ${source_version}; it was tagged by hand?"
fi
if [[ -n "$remote_tag_commit" && -n "$local_tag_commit" && "$remote_tag_commit" != "$local_tag_commit" ]]; then
    die 3 "${tag} names ${local_tag_commit:0:7} here but ${remote_tag_commit:0:7} on origin"
fi
if [[ -z "$remote_tag_commit" && -n "$local_tag_commit" ]] &&
    [[ "$(git -C "$repo" show "${tag}:${version_file}" | read_version)" != "$target" ]]; then
    die 3 "the local tag ${tag} is on a commit whose source does not say ${target}"
fi
if [[ "$formula_version" == "$target" && -z "$remote_tag_commit" ]]; then
    die 3 "the formula already points at ${tag}, but origin has no such tag"
fi

tagged=false
[[ -n "$remote_tag_commit" ]] && tagged=true
formula_done=false
[[ "$formula_version" == "$target" ]] && formula_done=true

# bottled: whether the formula's bottle block is this version's and has this machine's
# bottle. Stale after step 3, which drops the block when it moves the url.
bottled() {
    grep -qF "root_url \"https://github.com/${github_repo}/releases/download/${tag}\"" "$formula" &&
        grep -qF "${bottle_tag}: \"" "$formula"
}
bottle_done=true
$bottling && $formula_done && ! bottled && bottle_done=false
$bottling && ! $formula_done && bottle_done=false

if $tagged && $formula_done && $bottle_done; then
    say "${target} is already released. To release a new version: scripts/release <version>"
fi

if $dry_run; then
    $bump && say "would bump ${version_file} from ${source_version} to ${target} and commit it"
    if ! $tagged; then
        $skip_tests || say "would run: ${check}"
        say "would push main, then tag ${tag} and push it"
    fi
    $formula_done || say "would point ${formula} at ${tag}, with the tarball's sha256, and push the tap"
    if ! $bottle_done; then
        say "would build a ${bottle_tag} bottle of ${formula_ref}${sign:+, signed by ${sign}}${notary_profile:+ and notarized}"
        say "would upload it to ${github_repo}'s ${tag} release and write the formula's bottle block"
    fi
    $verify && say "would install ${formula_ref} through Homebrew, then brew test and brew audit"
    exit 0
fi

# --- 1. Bump, check, commit -----------------------------------------------------------

if ! $tagged; then
    if $bump; then
        say "Bumping ${source_version} → ${target}"
        old_line="${version_prefix}${source_version}${version_suffix}"
        new_line="${version_prefix}${target}${version_suffix}"
        done_once=false
        while IFS= read -r line || [[ -n "$line" ]]; do
            if ! $done_once && [[ "$line" == *"$old_line"* ]]; then
                line="${line/"$old_line"/"$new_line"}"
                done_once=true
            fi
            printf '%s\n' "$line"
        done <"${repo}/${version_file}" >"${repo}/${version_file}.new"
        mv "${repo}/${version_file}.new" "${repo}/${version_file}"
    fi
    if ! $skip_tests; then
        say "Running: ${check}"
        if ! (cd "$repo" && bash -c "$check"); then
            $bump && git -C "$repo" checkout -q -- "$version_file"
            die 5 "the check failed; nothing was committed or pushed"
        fi
    fi
    if $bump; then
        git -C "$repo" commit -q -m "Bumps the version to ${target}" -- "$version_file"
    fi

    # --- 2. Push, tag, push the tag -----------------------------------------------------

    say "Pushing main and ${tag}"
    git -C "$repo" push -q origin main || die 5 "could not push main"
    [[ -n "$local_tag_commit" ]] || git -C "$repo" tag -a "$tag" -m "${name} ${target}"
    git -C "$repo" push -q origin "$tag" || die 5 "could not push ${tag}"
fi

# --- 3. Point the formula at the tag --------------------------------------------------

if ! $formula_done; then
    url="${formula_url/\/v${formula_version}.tar.gz//${tag}.tar.gz}"
    say "Hashing ${url}"
    tarball="$(mktemp "${TMPDIR:-/tmp}/${formula_name}-release.XXXXXX")"
    trap 'rm -f "$tarball"' EXIT
    # GitHub can take a moment to serve the archive of a tag it has just received.
    for attempt in 1 2 3 4 5; do
        curl -fsSL -o "$tarball" "$url" && break
        [[ $attempt -lt 5 ]] || die 5 "could not download ${url}; rerun scripts/release to resume"
        sleep 3
    done
    sha="$(shasum -a 256 "$tarball" | cut -d' ' -f1)"

    # The previous version's bottle goes with its url, and the blank line before it.
    sed -e "s|^\( *url \"\).*\"$|\1${url}\"|" -e "s|^\( *sha256 \"\)[0-9a-f]*\"$|\1${sha}\"|" \
        "$formula" | awk '
            skip { if ($0 == "  end") skip = 0; next }
            $0 == "  bottle do" { skip = 1; blank = 0; next }
            blank { print ""; blank = 0 }
            $0 == "" { blank = 1; next }
            { print }
            END { if (blank) print "" }
        ' >"${formula}.new"
    mv "${formula}.new" "$formula"
    grep -qF "url \"${url}\"" "$formula" && grep -qF "sha256 \"${sha}\"" "$formula" ||
        die 5 "could not rewrite the url and sha256 in ${formula}"

    say "Pushing the formula at ${tag}"
    git -C "$tap" commit -q -m "Bumps ${formula_name} to ${target}" -- "Formula/${formula_name}.rb"
    git -C "$tap" push -q origin main || die 5 "could not push the tap; rerun scripts/release to resume"
fi

brew_tap_synced=false
# sync_brew_tap: brings Homebrew's copy of the tap up to the pushed formula, once.
sync_brew_tap() {
    $brew_tap_synced && return
    local brew_tap
    brew_tap="$(brew --repository "$tap_name")"
    if [[ -d "${brew_tap}/.git" ]]; then
        git -C "$brew_tap" pull -q --ff-only || die 5 "could not update Homebrew's copy of the tap at ${brew_tap}"
    else
        brew tap "$tap_name" || die 5 "could not tap ${tap_name}"
    fi
    brew_tap_synced=true
}

# keg_code <keg>: the Mach-O files in a keg, one per line.
keg_code() {
    local f
    while IFS= read -r -d '' f; do
        [[ "$(file -b "$f")" == Mach-O* ]] && echo "$f"
    done < <(find "$1" -type f -print0)
}

installed=false

# --- 4. Bottle it -----------------------------------------------------------------------

if ! $bottle_done; then
    sync_brew_tap
    say "Building a bottle of ${formula_ref}"
    if brew list --versions "$formula_name" >/dev/null 2>&1; then
        brew uninstall --formula "$formula_ref" || die 5 "could not uninstall ${formula_ref} to rebuild it"
    fi
    brew install --build-bottle "$formula_ref" || die 5 "the Homebrew build failed"
    installed=true
    keg="$(brew --cellar "$formula_ref")/${target}"
    [[ -d "$keg" ]] || die 5 "no keg at ${keg} after the build"
    work_dir="$(mktemp -d "${TMPDIR:-/tmp}/${formula_name}-bottle.XXXXXX")"
    trap 'rm -rf "$work_dir" "${tarball:-}"' EXIT

    if [[ -n "$sign" ]]; then
        code=()
        while IFS= read -r f; do code+=("$f"); done < <(keg_code "$keg")
        [[ ${#code[@]} -gt 0 ]] || die 5 "found no code to sign in ${keg}"
        say "Signing ${#code[@]} file(s) as ${sign}"
        for f in "${code[@]}"; do
            chmod u+w "$f"
            codesign --force --options runtime --timestamp --sign "$sign" "$f" || die 5 "could not sign ${f}"
            codesign --verify --strict "$f" || die 5 "the signature on ${f} does not verify"
        done
        if [[ -n "$notary_profile" ]]; then
            say "Notarizing (this waits for Apple)"
            ditto -c -k --keepParent "$keg" "${work_dir}/notarize.zip" || die 5 "could not zip ${keg}"
            result="$(xcrun notarytool submit "${work_dir}/notarize.zip" \
                --keychain-profile "$notary_profile" --wait --output-format json)" ||
                die 5 "notarytool failed: ${result}"
            status="$(jq -r .status <<<"$result")"
            [[ "$status" == Accepted ]] ||
                die 5 "notarization ${status}; see: xcrun notarytool log $(jq -r .id <<<"$result") --keychain-profile ${notary_profile}"
        fi
    fi

    root_url="https://github.com/${github_repo}/releases/download/${tag}"
    (cd "$work_dir" && brew bottle --json --no-rebuild --root-url="$root_url" "$formula_ref") ||
        die 5 "brew bottle failed"
    built=("$work_dir"/*.bottle.tar.gz)
    json=("$work_dir"/*.bottle.json)
    [[ -f "${built[0]}" && -f "${json[0]}" ]] || die 5 "brew bottle wrote no bottle in ${work_dir}"
    # The name Homebrew asks root_url for, under the formula's oldest macOS.
    asset="${work_dir}/${formula_name}-${target}.${bottle_tag}.bottle.tar.gz"
    mv "${built[0]}" "$asset"
    bottle_sha="$(shasum -a 256 "$asset" | cut -d' ' -f1)"
    cellar="$(jq -r '.[].bottle.tags[].cellar' "${json[0]}")"
    default_cellar=/usr/local/Cellar
    [[ "$(uname -m)" == arm64 ]] && default_cellar=/opt/homebrew/Cellar
    case "$cellar" in
        any | any_skip_relocation) cellar_arg="cellar: :${cellar}, " ;;
        "$default_cellar") cellar_arg="" ;;
        *) cellar_arg="cellar: \"${cellar}\", " ;;
    esac

    say "Uploading $(basename "$asset") to ${github_repo}'s ${tag} release"
    if ! gh release view "$tag" --repo "$github_repo" >/dev/null 2>&1; then
        gh release create "$tag" --repo "$github_repo" --verify-tag --title "${name} ${target}" --generate-notes ||
            die 5 "could not create the ${tag} release on ${github_repo}"
    fi
    gh release upload "$tag" "$asset" --repo "$github_repo" --clobber || die 5 "could not upload the bottle"

    # The bottle block replaces any older one and follows head, or license without it.
    anchor='^  license '
    grep -q '^  head ' "$formula" && anchor='^  head '
    awk -v anchor="$anchor" -v root_url="$root_url" -v line="${cellar_arg}${bottle_tag}: \"${bottle_sha}\"" '
        skip { if ($0 == "  end") skip = 0; next }
        $0 == "  bottle do" { skip = 1; blank = 0; next }
        blank { print ""; blank = 0 }
        $0 == "" { blank = 1; next }
        { print }
        !written && $0 ~ anchor {
            print ""
            print "  bottle do"
            print "    root_url \"" root_url "\""
            print "    sha256 " line
            print "  end"
            written = 1
        }
        END { if (blank) print "" }
    ' "$formula" >"${formula}.new"
    mv "${formula}.new" "$formula"
    bottled || die 5 "could not write the bottle block in ${formula}"

    say "Pushing the formula's ${bottle_tag} bottle"
    git -C "$tap" commit -q -m "Bottles ${formula_name} ${target} for ${bottle_tag}" -- "Formula/${formula_name}.rb"
    git -C "$tap" push -q origin main || die 5 "could not push the tap; rerun scripts/release to resume"
    brew_tap_synced=false
fi

# --- 5. Check it the way a user gets it -----------------------------------------------

$verify || exit 0
say "Checking ${formula_ref} through Homebrew"
sync_brew_tap
if $bottling; then
    # A fresh install, so Homebrew must fetch and pour the bottle from root_url.
    if $installed || brew list --versions "$formula_name" >/dev/null 2>&1; then
        brew uninstall --formula "$formula_ref" || die 5 "could not uninstall ${formula_ref}"
    fi
    brew install "$formula_ref" || die 5 "the Homebrew install failed"
    [[ "$(brew info --json=v2 "$formula_ref" | jq -r '.formulae[0].installed[0].poured_from_bottle')" == true ]] ||
        die 5 "Homebrew built ${formula_ref} instead of pouring the ${bottle_tag} bottle"
    if [[ -n "$sign" ]]; then
        while IFS= read -r f; do
            authority="$(codesign -dvv "$f" 2>&1 | sed -n 's/^Authority=//p' | head -1)"
            [[ "$authority" == "$sign" ]] || die 5 "${f} is signed by '${authority}', not ${sign}"
        done < <(keg_code "$(brew --cellar "$formula_ref")/${target}")
    fi
else
    # No --build-from-source: without a bottle Homebrew builds anyway, and the flag only
    # adds a "building from source is not supported" warning.
    if brew list --versions "$formula_name" >/dev/null 2>&1; then
        brew reinstall "$formula_ref" || die 5 "the Homebrew build failed"
    else
        brew install "$formula_ref" || die 5 "the Homebrew build failed"
    fi
fi
brew test "$formula_ref" || die 5 "brew test failed"
brew audit --strict "$formula_ref" || die 5 "brew audit failed"
say "Released ${formula_name} ${target}"
